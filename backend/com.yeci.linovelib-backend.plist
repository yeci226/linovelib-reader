<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yeci.linovelib-backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/yeci/linovelib-reader-backend/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/yeci/linovelib-reader-backend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/yeci</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/yeci/linovelib-reader-backend/server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/yeci/linovelib-reader-backend/server.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
